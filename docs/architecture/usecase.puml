@startuml
left to right direction

actor Customer
actor Seller

rectangle "Burim" {

    usecase "Browse Catalog" as BrowseCatalog
    usecase "Search Products" as SearchProducts
    usecase "View Product" as ViewProduct
    usecase "Compare Products" as CompareProducts
    usecase "Manage Cart" as ManageCart
    usecase "Place Order" as PlaceOrder
    usecase "View Orders" as ViewOrders

    usecase "Get Recommendations" as GetRecommendations
    usecase "Ask About Reviews" as AskAboutReviews
    usecase "Ask About Store Policies" as AskAboutPolicies

    usecase "List Product" as ListProduct
    usecase "Edit Product" as EditProduct
    usecase "Manage Inventory" as ManageInventory

    usecase "Suggest Category" as SuggestCategory
    usecase "Suggest Attributes" as SuggestAttributes
    usecase "Recommend Price" as RecommendPrice
}

Customer --> BrowseCatalog
Customer --> SearchProducts
Customer --> ViewProduct
Customer --> CompareProducts
Customer --> ManageCart
Customer --> PlaceOrder
Customer --> ViewOrders

Customer --> GetRecommendations
Customer --> AskAboutReviews
Customer --> AskAboutPolicies

Seller --> ListProduct
Seller --> EditProduct
Seller --> ManageInventory

Seller --> SuggestCategory
Seller --> SuggestAttributes
Seller --> RecommendPrice

ListProduct ..> SuggestCategory : <<extend>>
ListProduct ..> SuggestAttributes : <<extend>>
ListProduct ..> RecommendPrice : <<extend>>

@enduml